{
  "entities": {
    "Session": {
      "title": "Session",
      "description": "App session holding current game state and voting status",
      "type": "object",
      "properties": {
        "isVotingOpen": {
          "type": "boolean",
          "description": "Whether audience voting is open"
        },
        "maxVotesPerPerson": {
          "type": "number",
          "description": "Max votes allowed per voter"
        },
        "allowMultipleVotesPerParticipant": {
          "type": "boolean",
          "description": "Whether a voter can vote multiple times for the same participant"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["isVotingOpen", "updatedAt"]
    },
    "Voter": {
      "title": "Voter",
      "description": "Registered audience voter",
      "type": "object",
      "properties": {
        "nickname": {
          "type": "string",
          "maxLength": 50,
          "description": "Display nickname of the voter"
        },
        "joinedAt": {
          "type": "string",
          "description": "Join timestamp"
        },
        "isReady": {
          "type": "boolean",
          "description": "Readiness flag"
        }
      },
      "required": ["nickname", "joinedAt"]
    },
    "Vote": {
      "title": "Vote",
      "description": "Audience vote record",
      "type": "object",
      "properties": {
        "voterId": {
          "type": "string",
          "maxLength": 100,
          "description": "Identifier of the voter"
        },
        "nickname": {
          "type": "string",
          "maxLength": 50,
          "description": "Voter nickname"
        },
        "participantId": {
          "type": "number",
          "description": "Target participant ID"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["voterId", "participantId", "createdAt"]
    },
    "GayaSubmission": {
      "title": "GayaSubmission",
      "description": "Audience custom text submitted for moderator approval",
      "type": "object",
      "properties": {
        "voterId": {
          "type": "string",
          "maxLength": 100,
          "description": "Identifier of the sender"
        },
        "nickname": {
          "type": "string",
          "maxLength": 50,
          "description": "Nickname of sender"
        },
        "text": {
          "type": "string",
          "maxLength": 200,
          "description": "Submitted message text"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp in milliseconds"
        },
        "approved": {
          "type": "boolean",
          "description": "Whether moderator approved the message"
        }
      },
      "required": ["nickname", "text", "createdAt"]
    },
    "GayaStreamEvent": {
      "title": "GayaStreamEvent",
      "description": "Approved or instant comment/reaction event streaming across monitor screen",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 200,
          "description": "Streaming text or emoji"
        },
        "isTengu": {
          "type": "boolean",
          "description": "Whether this event is an oversized tengu emoji"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp in milliseconds"
        },
        "nickname": {
          "type": "string",
          "maxLength": 50,
          "description": "Optional sender nickname"
        }
      },
      "required": ["text", "createdAt"]
    }
  },
  "firestore": {
    "/sessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/Session"
      },
      "description": "Top-level session state"
    },
    "/sessions/{sessionId}/voters/{voterId}": {
      "schema": {
        "$ref": "#/entities/Voter"
      },
      "description": "Audience members in the session"
    },
    "/sessions/{sessionId}/votes/{voteId}": {
      "schema": {
        "$ref": "#/entities/Vote"
      },
      "description": "Votes cast in the session"
    },
    "/sessions/{sessionId}/gaya_submissions/{submissionId}": {
      "schema": {
        "$ref": "#/entities/GayaSubmission"
      },
      "description": "Custom text submitted by audience waiting for approval"
    },
    "/sessions/{sessionId}/gaya_stream/{eventId}": {
      "schema": {
        "$ref": "#/entities/GayaStreamEvent"
      },
      "description": "Real-time streaming text events rendered on monitor"
    }
  }
}
